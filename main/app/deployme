#!/usr/bin/env bash
# Local deploy to Posit Connect. UNTESTED stand-in. Needs CONNECT_SERVER and CONNECT_API_KEY in a gitignored .env
# (handed out at the event). The GitHub Actions workflow from the course template is the main deploy path.
set -e
cd "$(dirname "$0")/.."
set -a; source .env; set +a
rsconnect deploy manifest -s "$CONNECT_SERVER" -k "$CONNECT_API_KEY" app/manifest.json
